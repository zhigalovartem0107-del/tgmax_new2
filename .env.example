# Copy to .env and fill in. Real environment variables override this file.

# MAX bot token (BOT_TOKEN and MAX_TOKEN are accepted too)
MAX_BOT_TOKEN=

# Comma-separated MAX user ids of admins
ADMIN_IDS=

# Default: SQLite file in ./data/bot.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=

# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# AI lyrics via OpenRouter (key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Models to try in order, comma-separated (ids ending in ":free": https://openrouter.ai/models).
# Each gets OPENROUTER_TIMEOUT seconds for the whole answer, then the next one is tried.
# Default: google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,openrouter/free
# OPENROUTER_MODEL=
# OPENROUTER_TIMEOUT=30
# AI lyrics drafts per song order (the first one plus regenerations); 0: no limit
# LYRICS_DRAFTS_MAX=10

# Songs: ACE-Step 1.5 on acemusic.ai, free (key: https://acemusic.ai/api-key).
# MUSIC_API_KEY works too. Or set it in the bot: /admin → 🔑 API Ключи (that one wins
# and needs no restart; the same goes for VK_TOKEN, VK_COOKIES, TIKTOK_COOKIES below).
ACEMUSIC_API_KEY=
# Optional: model id (default: the first one the API lists) and song length,
# 5-240 s (default 180)
# MUSIC_MODEL=acemusic/acestep-v15-turbo
# MUSIC_DURATION=180

# Video: Agnes AI, agnes-video-v2.0 (key: https://platform.agnes-ai.com/). The free plan
# takes 1 video a minute. Or set it in the bot: /admin → 🔑 API Ключи (wins, no restart).
AGNES_API_KEY=
# Optional: API addresses, comma-separated, tried in order when one can't be reached
# AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1,https://apihub.agnes-ai.com/v1
# AGNES_VIDEO_MODEL=agnes-video-v2.0
# Price of a video in balance units (default: SONG_PRICE)
# VIDEO_PRICE=

LOG_LEVEL=INFO

# --- Shop (/shop) ---
# The shop's own email for the 54-FZ receipt when a buyer has no email (optional):
# YOOKASSA_RECEIPT_EMAIL=shop@example.com
# Shown and accepted before every payment:
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy
# Balance packages, "units:rubles" comma-separated:
# SHOP_PACKAGES=5:199,15:499,40:990

# --- Social sources (services/social) ---
# VK_TOKEN=               # VK service key: vk.com/apps → your app → «Сервисный ключ доступа»
# VK_COOKIES=             # fallback: your logged-in vk.com cookies, e.g. remixsid=...
# TIKTOK_COOKIES=         # fallback: your logged-in tiktok.com cookies, e.g. sessionid=...
