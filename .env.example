# Copy to .env and fill in. Real environment variables override this file.

# MAX bot token (BOT_TOKEN and MAX_TOKEN are accepted too)
MAX_BOT_TOKEN=

# Comma-separated MAX user ids of admins
ADMIN_IDS=

# Default: SQLite file in ./data/bot.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
# DATABASE_URL=

# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# AI lyrics via OpenRouter (key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Default: openrouter/free (any currently available free model). To pin one,
# use an id ending in ":free" from https://openrouter.ai/models
# OPENROUTER_MODEL=openrouter/free

# Songs: an ACE-Step 1.5 API server (https://github.com/ace-step/ACE-Step-1.5),
# e.g. https://your-space.hf.space or http://your-gpu-pc:8001
MUSIC_API_URL=
# Its ACESTEP_API_KEY, if the server has one
# MUSIC_API_KEY=
# VIDEO_API_URL=
# VIDEO_API_KEY=

LOG_LEVEL=INFO
